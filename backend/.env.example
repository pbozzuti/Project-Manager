# Local dev works with no DATABASE_URL set (falls back to SQLite in backend/app/dev.db).
# For Supabase Postgres, get this from Project Settings > Database > Connection string (URI, "Session pooler")
# and swap postgres:// for postgresql://
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Comma-separated origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

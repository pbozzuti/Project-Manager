NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). See README for the full setup walkthrough.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

ALLOWED_GOOGLE_DOMAIN=adamstheatrecompany.com

# Generate with: openssl rand -base64 32 — must match INTERNAL_API_SECRET
# in backend/.env exactly.
INTERNAL_API_SECRET=
